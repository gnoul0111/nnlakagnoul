rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════════════════
    // HELPER FUNCTIONS
    // ═══════════════════════════════════════════════════════════════════════

    // Đã đăng nhập
    function authed() {
      return request.auth != null;
    }

    // Đã đăng nhập VÀ là chủ sở hữu của uid
    function isMe(uid) {
      return authed() && request.auth.uid == uid;
    }

    // userId KHÔNG được thay đổi sau khi tạo document
    // BUG GỐC: rules cũ thiếu check này → user có thể update userId sang người khác
    function userIdLocked() {
      return request.resource.data.userId == resource.data.userId;
    }

    // Validate dữ liệu event trước khi ghi vào expense_events
    function validEvent() {
      let d = request.resource.data;

      // 1. Các field bắt buộc phải tồn tại
      let hasRequired = d.keys().hasAll(['userId', 'eventType', 'createdAt', 'data']);

      // 2. Kiểu dữ liệu cơ bản
      let validTypes = d.userId is string
        && d.eventType is string
        && d.createdAt is string
        && d.data is map;

      // 3. eventType phải nằm trong danh sách cho phép (whitelist)
      //    Ngăn client inject event type giả
      let validEventType = d.eventType in [
        'EXPENSE_ADDED',   'EXPENSE_UPDATED',  'EXPENSE_DELETED',
        'INCOME_ADDED',    'INCOME_CREATED',   'INCOME_DELETED',
        'BUDGET_SET',
        'GOAL_ADDED',      'GOAL_CREATED',     'GOAL_UPDATED',     'GOAL_DELETED',
        'GOAL_DEPOSIT_ADDED', 'GOAL_DEPOSIT_EDITED', 'GOAL_DEPOSIT_DELETED',
        'DEBT_CREATED',    'DEBT_UPDATED',     'DEBT_DELETED',
        'DEBT_PAYMENT_ADDED', 'DEBT_PAYMENT_DELETED',
        'TEMPLATE_CREATED', 'TEMPLATE_DELETED',
        'SAVINGS_TARGET_SET',      'SAVINGS_DEPOSIT',           'SAVINGS_DEPOSIT_DELETED',
        'SAVINGS_ALLOCATED',       'SAVINGS_ALLOCATION_DELETED',
        'SAVINGS_WITHDRAWN',       'SAVINGS_WITHDRAWAL_DELETED'
      ];

      // 4. Nếu event.data chứa amount → phải là số dương, không vượt quá 1 tỷ
      //    Ngăn: amount âm, amount = 0, amount overflow gây lỗi analytics
      let validAmount = !('amount' in d.data)
        || (d.data.amount is number
            && d.data.amount > 0
            && d.data.amount < 1000000000);

      // 5. Tối đa 20 fields trong data object (chống payload bomb)
      let validSize = d.data.size() <= 20;

      return hasRequired && validTypes && validEventType && validAmount && validSize;
    }

    // ─── Module nhóm (chi tiêu chung) ──────────────────────────────────────
    //
    // request.auth.uid là thành viên của group {groupId}?
    // Dùng get() → tốn 1 read/lần write. Chỉ áp cho CREATE event (ít hơn read).
    // READ event KHÔNG get() — gate bằng `uid in resource.data.participants`.
    function isGroupMember(groupId) {
      return authed()
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids;
    }

    // Validate event nhóm trước khi ghi vào group_events
    function validGroupEvent() {
      let d = request.resource.data;
      let hasRequired = d.keys().hasAll(['groupId', 'actorUid', 'participants', 'eventType', 'data', 'createdAt']);
      let validTypes = d.groupId is string
        && d.actorUid is string
        && d.participants is list
        && d.eventType is string
        && d.data is map
        && d.createdAt is string;
      let validEventType = d.eventType in ['GROUP_ENTRY_ADDED', 'GROUP_ENTRY_UPDATED', 'GROUP_ENTRY_DELETED', 'GROUP_ENTRY_STATUS_SET'];
      // total (nếu có) phải dương, không overflow
      let validTotal = !('total' in d.data)
        || (d.data.total is number && d.data.total >= 0 && d.data.total < 1000000000);
      let validSize = d.data.size() <= 30 && d.participants.size() <= 50;
      // STATUS_SET: chỉ được set trạng thái CỦA CHÍNH MÌNH + giá trị hợp lệ.
      let validStatus = d.eventType != 'GROUP_ENTRY_STATUS_SET'
        || (d.data.uid == request.auth.uid && d.data.status in ['pending', 'done', 'skipped']);
      return hasRequired && validTypes && validEventType && validTotal && validSize && validStatus;
    }


    // ═══════════════════════════════════════════════════════════════════════
    // EXPENSE_EVENTS — append-only event log (event-sourcing)
    // ═══════════════════════════════════════════════════════════════════════
    //
    // ⚠️ FIX 1: update + delete → if false
    //    Client KHÔNG BAO GIỜ cần sửa/xóa event đã ghi.
    //    "Xóa expense" = append thêm EXPENSE_DELETED event, không phải xóa doc.
    //    Rules cũ cho phép update/delete là thừa và nguy hiểm.
    //
    // ⚠️ FIX 2: create thêm validEvent() để validate payload
    //    Rules cũ chỉ check userId, không validate eventType, amount, v.v.
    //
    match /expense_events/{docId} {
      allow get:    if isMe(resource.data.userId);
      allow list:   if isMe(resource.data.userId);
      allow create: if isMe(request.resource.data.userId) && validEvent();
      allow update: if false;  // Events bất biến (immutable)
      allow delete: if false;  // Events bất biến (immutable)
    }


    // ═══════════════════════════════════════════════════════════════════════
    // EXPENSE_SNAPSHOTS — replay cache, docId = userId
    // ═══════════════════════════════════════════════════════════════════════
    // App lưu snapshot tính sẵn để cold-start nhanh (tier 3). docId chính là uid.
    // BUG GỐC: collection này thiếu rule → mọi read/write bị default-deny
    // → "Missing or insufficient permissions" (non-fatal, app fallback replay events).
    match /expense_snapshots/{userId} {
      allow read, write: if isMe(userId);
    }


    // ═══════════════════════════════════════════════════════════════════════
    // LEGACY V4 COLLECTIONS — chỉ dùng khi import dữ liệu cũ
    // ═══════════════════════════════════════════════════════════════════════
    //
    // ⚠️ FIX 3: thêm userIdLocked() vào update
    //    Rules cũ thiếu check này → user có thể update userId sang người khác.
    //    Áp dụng cho TẤT CẢ collections có update rule dùng resource.data.userId.
    //
    match /expenses/{docId} {
      allow get:    if isMe(resource.data.userId);
      allow list:   if isMe(resource.data.userId);
      allow create: if isMe(request.resource.data.userId);
      allow update: if isMe(resource.data.userId) && userIdLocked();
      allow delete: if isMe(resource.data.userId);
    }

    match /incomes/{docId} {
      allow get:    if isMe(resource.data.userId);
      allow list:   if isMe(resource.data.userId);
      allow create: if isMe(request.resource.data.userId);
      allow update: if isMe(resource.data.userId) && userIdLocked();
      allow delete: if isMe(resource.data.userId);
    }

    match /debts/{docId} {
      allow get:    if isMe(resource.data.userId);
      allow list:   if isMe(resource.data.userId);
      allow create: if isMe(request.resource.data.userId);
      allow update: if isMe(resource.data.userId) && userIdLocked();
      allow delete: if isMe(resource.data.userId);
    }

    match /goals/{docId} {
      allow get:    if isMe(resource.data.userId);
      allow list:   if isMe(resource.data.userId);
      allow create: if isMe(request.resource.data.userId);
      allow update: if isMe(resource.data.userId) && userIdLocked();
      allow delete: if isMe(resource.data.userId);
    }

    match /templates/{docId} {
      allow get:    if isMe(resource.data.userId);
      allow list:   if isMe(resource.data.userId);
      allow create: if isMe(request.resource.data.userId);
      allow update: if isMe(resource.data.userId) && userIdLocked();
      allow delete: if isMe(resource.data.userId);
    }


    // ═══════════════════════════════════════════════════════════════════════
    // BUDGETS — docId pattern: "{userId}_{month}"
    // ═══════════════════════════════════════════════════════════════════════
    match /budgets/{docId} {
      allow read, write: if authed() && docId.matches(request.auth.uid + '_.*');
    }


    // ═══════════════════════════════════════════════════════════════════════
    // USER PROFILE
    // ═══════════════════════════════════════════════════════════════════════
    match /users/{userId} {
      allow read, write: if isMe(userId);
    }


    // ═══════════════════════════════════════════════════════════════════════
    // USER SETTINGS + SUBCOLLECTIONS
    // ═══════════════════════════════════════════════════════════════════════
    match /user_settings/{userId} {
      allow read, write: if isMe(userId);

      // FCM tokens — mỗi device một doc, client quản lý token của chính mình
      match /fcm_tokens/{deviceId} {
        allow read, write: if isMe(userId);
      }

      // Alert log — Cloud Function ghi (admin SDK bypass rules), client chỉ đọc
      match /alert_log/{alertKey} {
        allow read:  if isMe(userId);
        allow write: if false;  // Cloud Function only
      }
    }


    // ═══════════════════════════════════════════════════════════════════════
    // USER TAGS — docId pattern: "{userId}_cat_prefs"
    // ═══════════════════════════════════════════════════════════════════════
    match /user_tags/{docId} {
      allow read, write: if authed() && docId.matches(request.auth.uid + '_.*');
    }


    // ═══════════════════════════════════════════════════════════════════════
    // WORK CALENDAR
    // ═══════════════════════════════════════════════════════════════════════
    //
    // ⚠️ FIX 3 (tiếp): userIdLocked() trên update
    //
    match /work_calendar/{docId} {
      allow get:    if isMe(resource.data.userId);
      allow list:   if isMe(resource.data.userId);
      allow create: if isMe(request.resource.data.userId);
      allow update: if isMe(resource.data.userId) && userIdLocked();
      allow delete: if isMe(resource.data.userId);
    }

    // ⚠️ FIX 4: cal_events không tồn tại trong COLLECTIONS của app
    //    Rules cũ có match /cal_events/ nhưng code không dùng collection này.
    //    Xóa rule không dùng để tránh attack surface dư thừa.
    //    (Nếu sau này cần thêm lại thì uncomment và review kỹ)


    // ═══════════════════════════════════════════════════════════════════════
    // GROUPS — danh bạ thành viên + mã mời (chi tiêu chung, MULTI-USER)
    // ═══════════════════════════════════════════════════════════════════════
    //
    // Đây là dữ liệu dùng chung ĐẦU TIÊN (khác mô hình isMe). Đọc kỹ:
    //  • Đọc nhóm: phải là thành viên (uid ∈ memberUids).
    //  • Tạo nhóm: người tạo là owner DUY NHẤT và là thành viên đầu tiên duy nhất.
    //  • THAM GIA (đổi memberUids): làm qua API route admin SDK (bypass rules).
    //    Client KHÔNG được tự thêm mình vào nhóm → tránh IDOR qua mã đoán.
    //  • Client update chỉ cho owner sửa field thường, KHÓA memberUids + ownerUid.
    match /groups/{groupId} {
      allow get:  if authed() && request.auth.uid in resource.data.memberUids;
      allow list: if authed() && request.auth.uid in resource.data.memberUids;
      allow create: if authed()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid];
      allow update: if authed()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.memberUids == resource.data.memberUids;
      allow delete: if authed() && resource.data.ownerUid == request.auth.uid;
    }


    // ═══════════════════════════════════════════════════════════════════════
    // GROUP_EVENTS — append-only sổ chung (event-sourcing), quyền theo KHOẢN
    // ═══════════════════════════════════════════════════════════════════════
    //
    //  • Đọc: CHỈ người trong khoản (uid ∈ participants). Field ngay trên doc
    //    → KHÔNG cần get() → đọc nhanh. Người ngoài không thấy khoản tồn tại.
    //  • Tạo: actor phải là chính mình, phải nằm trong participants, và phải là
    //    THÀNH VIÊN nhóm (get() — chỉ tốn read lúc write). Validate payload.
    //  • Immutable: sửa/xóa khoản = append event mới (không update/delete doc).
    //
    //  ⚠️ Known-limit (Pha 1): rules CHƯA ép "chỉ người tạo được sửa" và "mọi
    //  participant phải là member" (cần get() tốn kém / đọc event gốc). Ép tạm ở
    //  UI/service. App gia đình tin nhau → chấp nhận. TODO siết sau nếu cần.
    match /group_events/{docId} {
      allow get:  if authed() && request.auth.uid in resource.data.participants;
      allow list: if authed() && request.auth.uid in resource.data.participants;
      allow create: if authed()
        && request.resource.data.actorUid == request.auth.uid
        && request.auth.uid in request.resource.data.participants
        && isGroupMember(request.resource.data.groupId)
        && validGroupEvent();
      allow update: if false;
      allow delete: if false;
    }

  }
}
