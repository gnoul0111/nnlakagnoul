# ─── Firebase ─────────────────────────────────────────────────────────────────
# KHÔNG commit file .env.local thật vào git.
# File này là template — copy thành .env.local và điền giá trị thật.
# Lấy từ: Firebase Console → Project Settings → Your apps → Web app → Config

NEXT_PUBLIC_FIREBASE_API_KEY="your_firebase_api_key_here"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your_project_id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your_project_id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your_project_id.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your_messaging_sender_id"
NEXT_PUBLIC_FIREBASE_APP_ID="your_app_id"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="your_measurement_id"
NEXT_PUBLIC_FIREBASE_VAPID_KEY="your_vapid_key"

# ─── Firebase App Check ────────────────────────────────────────────────────────
# Lấy từ: Google Cloud Console → reCAPTCHA Enterprise → tạo site key
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# Debug token cho local development (KHÔNG commit giá trị thật)
# Lấy từ: Firebase Console → App Check → Apps → Manage debug tokens
NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=your-debug-token-here

# ─── Firebase Admin SDK (server-side only) ────────────────────────────────────
# Lấy từ: Firebase Console → Project Settings → Service accounts → Generate new private key
# Paste TOÀN BỘ nội dung JSON vào đây (trên 1 dòng, đã escape)
# KHÔNG commit giá trị thật — file này chỉ là template
FIREBASE_ADMIN_CREDENTIALS='{"type":"service_account","project_id":"your_project_id",...}'

# ─── AI (Gemini) ────────────────────────────────────────────────────────────────
# Server-side only — KHÔNG thêm NEXT_PUBLIC_ prefix
# Lấy từ: https://aistudio.google.com
GEMINI_API_KEY="your_gemini_api_key_here"

# ─── App (Cloud Functions) ────────────────────────────────────────────────────
# Domain của app dùng cho CORS whitelist trong Cloud Functions
APP_ORIGIN="https://your-app.vercel.app"
