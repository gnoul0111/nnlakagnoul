{
  "name": "chitieu-functions",
  "version": "1.0.0",
  "description": "Firebase Cloud Functions for Chi Tiêu app",
  "scripts": {
    "build":   "tsc",
    "watch":   "tsc --watch",
    "serve":   "npm run build && firebase emulators:start --only functions",
    "deploy":  "firebase deploy --only functions",
    "logs":    "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0"
  },
  "private": true
}